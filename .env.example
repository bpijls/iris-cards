# Public hostname served by Caddy
APP_DOMAIN=example.com

# vonk (LiteLLM) server used by build.py to generate card art
VONK_BASE_URL=http://your-vonk-host:4000/v1
VONK_API_KEY=changeme

# External Docker network shared with the Caddy Docker Proxy
CADDY_NETWORK=proxy

# Local-only port (used when the ports: block in docker-compose.yml is enabled)
HOST_PORT=8777
